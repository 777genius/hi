# API ключи для STT провайдеров
# Скопируйте этот файл в .env и добавьте ваши API ключи

# AssemblyAI (https://www.assemblyai.com)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Deepgram (https://www.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Cloud Speech-to-Text (опционально)
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Anthropic (Haiku) — для анализа текста по hover в UI
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Опционально: модель/параметры
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TEMPERATURE=0.2

# LLM провайдер (опционально, по умолчанию anthropic)
# Возможные значения: anthropic | openai_compatible | backend
# LLM_PROVIDER=anthropic

# Общие параметры (опционально)
# LLM_MODEL=your_model_id_here
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.2
# LLM_SYSTEM_PROMPT=...

# OpenAI-compatible (например OpenAI / OpenRouter и другие совместимые прокси)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=your_model_id_here
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MAX_TOKENS=1024
# OPENAI_TEMPERATURE=0.2
# OPENAI_SYSTEM_PROMPT=...

# Backend LLM (в будущем: проксирование/роутинг моделей на нашей стороне)
# LLM_BACKEND_URL=https://api.example.com
# LLM_BACKEND_AUTH_TOKEN=your_backend_token_here
