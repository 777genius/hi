# API ключи для STT провайдеров
# Скопируйте этот файл в .env и добавьте ваши API ключи

# AssemblyAI (https://www.assemblyai.com)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Deepgram (https://www.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Cloud Speech-to-Text (опционально)
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Anthropic (Haiku) — для анализа текста по hover в UI
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Опционально: модель/параметры
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TEMPERATURE=0.2

# LLM провайдер (опционально, по умолчанию anthropic)
# Возможные значения: anthropic | openai_compatible | backend
# LLM_PROVIDER=anthropic

# Общие параметры (опционально)
# LLM_MODEL=your_model_id_here
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.2
# LLM_SYSTEM_PROMPT=...

# OpenAI-compatible (например OpenAI / OpenRouter и другие совместимые прокси)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=your_model_id_here
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MAX_TOKENS=1024
# OPENAI_TEMPERATURE=0.2
# OPENAI_SYSTEM_PROMPT=...

# Backend LLM (в будущем: проксирование/роутинг моделей на нашей стороне)
# LLM_BACKEND_URL=https://api.example.com
# LLM_BACKEND_AUTH_TOKEN=your_backend_token_here

# Memo Stack service (recommended)
# Start platform deps from HackInterview:
# pnpm memo-stack:up
# Start server in another terminal:
# pnpm memo-stack:server
# Run desktop:
# pnpm tauri:dev:memo-stack
# INTERVIEW_MEMORY_API_VARIANT=platform
# INTERVIEW_MEMORY_API_URL=http://127.0.0.1:7788
# INTERVIEW_MEMORY_AUTH_TOKEN=local-dev-token
# INTERVIEW_MEMORY_SPACE_SLUG=hackinterview
# INTERVIEW_MEMORY_PROFILE_EXTERNAL_REF=default

# Local interview memory (optional, recommended for persistent recall)
# Start with: docker compose -f docker-compose.memory.yml up -d
# INTERVIEW_MEMORY_DB_URL=postgres://hackinterview:hackinterview@127.0.0.1:54329/hackinterview_memory
# INTERVIEW_MEMORY_LOCAL_DB_ENABLED=true
# INTERVIEW_MEMORY_EMBEDDINGS_ENABLED=true
# INTERVIEW_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# INTERVIEW_MEMORY_EMBEDDING_DIMENSIONS=1536

# Signal integration (optional)
# Запустите docker-compose.signal.yml, залинкуйте устройство через QR и укажите номер аккаунта.
# SIGNAL_ENABLED=true
# SIGNAL_API_BASE_URL=http://localhost:8081
# SIGNAL_ACCOUNT_NUMBER=+380001112233
# SIGNAL_RECEIVE_RECONNECT_MIN_SECONDS=1
# SIGNAL_RECEIVE_RECONNECT_MAX_SECONDS=30
# Best-effort auto-accept for Signal message requests.
# Preferred when the signal-cli JSON-RPC daemon is reachable directly:
# SIGNAL_MESSAGE_REQUEST_AUTO_ACCEPT=true
# SIGNAL_MESSAGE_REQUEST_JSON_RPC_ADDR=127.0.0.1:6001
# Local Docker fallback for bbernhard/signal-cli-rest-api json-rpc-native:
# SIGNAL_MESSAGE_REQUEST_DOCKER_CONTAINER=hackinterview-signal-api
# SIGNAL_MESSAGE_REQUEST_DOCKER_BINARY=docker
# SIGNAL_MESSAGE_REQUEST_ACCEPT_TIMEOUT_SECONDS=12
# SIGNAL_MESSAGE_REQUEST_ACCEPT_RETRY_ATTEMPTS=5
# SIGNAL_MESSAGE_REQUEST_ACCEPT_RETRY_DELAY_SECONDS=3
