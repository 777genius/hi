{
  "name": "voice-to-text",
  "version": "0.1.0",
  "type": "module",
  "description": "Privacy-focused voice-to-text application with offline support",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:whisper": "tauri dev --features whisper",
    "tauri:build:whisper": "tauri build --features whisper",
    "copy-helper:build": "tools/macos-focus-copy-helper/scripts/build-app.sh",
    "copy-helper:run": "tools/macos-focus-copy-helper/scripts/start-supervisor.sh",
    "copy-helper:stop": "tools/macos-focus-copy-helper/scripts/stop-supervisor.sh",
    "copy-helper:status": "tools/macos-focus-copy-helper/scripts/status-supervisor.sh",
    "copy-helper:check": "tools/macos-focus-copy-helper/scripts/check-accessibility.sh",
    "copy-helper:logs": "tail -n 200 -f \"$HOME/Library/Logs/HackInterview/MacOSFocusCopyHelper.log\"",
    "copy-helper:browser-extension:install": "tools/browser-focus-copy-extension/install-native-host.sh",
    "copy-helper:browser-extension:e2e": "node tools/browser-focus-copy-extension/e2e-adapters.mjs",
    "cursor-extension:install": "node tools/cursor-focus-copy-extension/scripts/install.mjs",
    "cursor-extension:e2e": "node tools/cursor-focus-copy-extension/e2e/run-extension-e2e.mjs",
    "copy-helper:brave:open-cdp": "tools/browser-focus-copy-extension/open-brave-silent-debugger.sh open",
    "copy-helper:brave:restart-cdp": "tools/browser-focus-copy-extension/open-brave-silent-debugger.sh restart",
    "e2e:tauri": "node e2e-tests/run-e2e.mjs",
    "e2e:companion-audio": "node e2e-tests/companion-dual-audio-smoke.mjs",
    "e2e:companion-context": "node e2e-tests/companion-synthetic-context.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@statesync/core": "^1.1.0",
    "@statesync/pinia": "^2.0.0",
    "@statesync/tauri": "^2.0.0",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.2",
    "marked-highlight": "^2.2.3",
    "pinia": "^2.1.0",
    "qrcode": "1.5.4",
    "refresh-fetch": "^0.9.0",
    "shiki": "^3.22.0",
    "vue": "^3.4.0",
    "vue-i18n": "^11.2.8",
    "vuetify": "^3.7.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-deep-link": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@wdio/cli": "^9.19.0",
    "@wdio/local-runner": "^9.19.0",
    "@wdio/mocha-framework": "^9.19.0",
    "@wdio/spec-reporter": "^9.19.0",
    "expect-webdriverio": "^5.4.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.1.0",
    "webdriverio": "^9.19.0"
  }
}
