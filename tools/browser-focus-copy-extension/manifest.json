{
  "manifest_version": 3,
  "name": "HackInterview Focus Copy Bridge",
  "version": "0.1.0",
  "description": "Keeps the focused editable text cached locally for the macOS Ctrl+Shift+A copy helper.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "116"
}
